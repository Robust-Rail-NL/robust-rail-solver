<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ServiceSiteScheduling</RootNamespace>
    <AssemblyName>ServiceSiteScheduling</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);IDE0305</NoWarn>
    <Version>2.0.0</Version>
    <!--
      Without this, the SDK silently appends "+<40-char-git-sha>" to
      AssemblyInformationalVersionAttribute for any build in a git repo,
      regardless of what <Version> says — confirmed empirically, e.g. an
      ordinary build here produces "2.0.0+d05f1a7065f9183d8227d04992fdfb781746f524".
      Program.cs prints that attribute verbatim as the startup "HIP {Version}"
      line, so without disabling this, every release would carry an unwanted,
      unrelated SDK-injected hash there. Builds that *do* want a build-metadata
      suffix (e.g. docker-push-edge.sh's <release>-edge+<date>.<short-sha>)
      pass their own complete string via `dotnet publish -p:Version=...`,
      which this does not affect.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!--
    Local dev builds (a bare `dotnet run`/`dotnet build`, which default to
    Debug) get their own build-metadata-suffixed InformationalVersion,
    computed automatically so nobody has to remember to touch it - e.g.
    "2.0.0-local+20260910.a1b2c3d" for Program.cs's startup "HIP {Version}"
    line. Mirrors docker-push-edge.sh's <release>-edge+<date>.<sha> scheme,
    with "local" instead of "edge".

    Gated on Configuration==Debug because that's the one signal that
    distinguishes "somebody just ran the app locally" from every other build
    path: docker-push.sh and docker-push-edge.sh both always build Release
    AND pass their own -p:Version explicitly (which wins regardless), and a
    local `dotnet publish -c Release` is close enough to a real release
    build that it should show the plain <Version> too.

    Falls back to "nogit" for the sha if git isn't available (e.g. building
    from a source tarball with no .git) rather than failing the build.
  -->
  <Target Name="ComputeLocalInformationalVersion" BeforeTargets="GetAssemblyAttributes" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="git rev-parse --short HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
    </Exec>
    <PropertyGroup>
      <_GitShortSha Condition="'$(_GitShortSha)' == ''">nogit</_GitShortSha>
      <_VersionDashIndex>$(Version.IndexOf('-'))</_VersionDashIndex>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_VersionDashIndex)' != '-1'">
      <_ReleaseVersion>$(Version.Substring(0, $(_VersionDashIndex)))</_ReleaseVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_VersionDashIndex)' == '-1'">
      <_ReleaseVersion>$(Version)</_ReleaseVersion>
    </PropertyGroup>
    <PropertyGroup>
      <InformationalVersion>$(_ReleaseVersion)-local+$([System.DateTime]::UtcNow.ToString('yyyyMMdd')).$(_GitShortSha)</InformationalVersion>
    </PropertyGroup>
  </Target>
  <!--
    Assertions are normally tied to the build configuration, forcing a choice
    between optimised-but-unchecked and checked-but-slow. The solver is a
    wall-clock-bounded local search, so a Debug build explores far fewer
    neighbours per second and returns different, worse plans - which makes it
    useless for integration testing. Building Release with DEBUG defined keeps
    the optimisation and the plans identical while leaving Debug.Assert live,
    so e.g. PlanGraph.CheckGraphStructure still runs.

    Enable with: dotnet publish -c Release -p:Assertions=true
  -->
  <PropertyGroup Condition="'$(Assertions)' == 'true'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    <PackageReference Include="OptimizedPriorityQueue" Version="5.1.0" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>
</Project>
